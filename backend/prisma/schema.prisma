// HAVENPET SCM — PostgreSQL schema
// Step 1: Users, Stores, Products, SKUs, Inventory, Orders, Payments, Logistics

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  hq_admin
  store_manager
}

enum WarehouseType {
  hq_central
  store_retail
}

enum OrderStatus {
  draft
  pending_payment
  paid_awaiting_shipment
  shipped_in_transit
  customs_clearance
  arrived_at_store
  completed
  refunded
  cancelled
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum PaymentMethod {
  credit_card
  bank_wire
  stripe
  paypal
}

enum ShipmentMilestone {
  order_confirmed
  packed_at_hq
  departed_origin
  in_transit
  customs_clearance
  arrived_at_destination
  delivered_to_store
}

enum InventoryMovementType {
  inbound
  outbound
  transfer
  adjustment
  sale
  restock
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  storeId      String?  @map("store_id")
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ordersCreated       Order[]              @relation("OrderCreatedBy")
  paymentsApproved    Payment[]            @relation("PaymentApprovedBy")
  inventoryMovements  InventoryMovement[]  @relation("MovementCreatedBy")
  refreshTokens       RefreshToken[]

  @@index([role])
  @@index([storeId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stores (Overseas locations)
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. DE-BERLIN-01
  name          String
  country       String
  city          String
  address       String
  postalCode    String?  @map("postal_code")
  latitude      Float?
  longitude     Float?
  contactName   String   @map("contact_name")
  contactEmail  String   @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  currency      String   // ISO 4217: EUR, CAD, USD
  taxRate       Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  importDutyRate Decimal @default(0) @map("import_duty_rate") @db.Decimal(5, 4)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users              User[]
  inventories        Inventory[]
  safetyStockRules   SafetyStockRule[]
  orders             Order[]
  inventoryMovements InventoryMovement[]

  @@index([country])
  @@map("stores")
}

// ─────────────────────────────────────────────────────────────────────────────
// Products & SKUs
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  skuCode     String   @unique @map("sku_code") // parent product code
  name        String
  description String?
  category    String   // e.g. dry_food, wet_food, treats
  brand       String   @default("HAVENPET")
  basePriceUsd Decimal @map("base_price_usd") @db.Decimal(12, 2)
  basePriceRmb Decimal? @map("base_price_rmb") @db.Decimal(12, 2)
  supplierName String? @map("supplier_name")
  supplierContact String? @map("supplier_contact")
  isActive    Boolean  @default(true) @map("is_active")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skus Sku[]

  @@index([category])
  @@map("products")
}

model Sku {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuVariantCode String @unique @map("sku_variant_code") // e.g. HVP-SALMON-12KG
  flavour     String?  // Salmon, Chicken, etc.
  weightKg    Decimal? @map("weight_kg") @db.Decimal(8, 3)
  weightLabel String?  @map("weight_label") // "12kg", "2kg"
  barcode     String?  @unique
  priceUsd    Decimal  @map("price_usd") @db.Decimal(12, 2)
  priceRmb    Decimal? @map("price_rmb") @db.Decimal(12, 2)
  shelfLifeDays Int?   @map("shelf_life_days")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventories        Inventory[]
  inventoryBatches     InventoryBatch[]
  safetyStockRules   SafetyStockRule[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId])
  @@map("skus")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory (Multi-warehouse + FIFO batches)
// ─────────────────────────────────────────────────────────────────────────────

model Inventory {
  id            String        @id @default(cuid())
  skuId         String        @map("sku_id")
  sku           Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouseType WarehouseType @map("warehouse_type")
  storeId       String?       @map("store_id") // null = HQ central warehouse
  store         Store?        @relation(fields: [storeId], references: [id])
  locationKey   String        @map("location_key") // "hq" or store id — stable unique key
  quantity      Int           @default(0)
  reservedQty   Int           @default(0) @map("reserved_qty") // allocated to pending orders
  updatedAt     DateTime      @updatedAt @map("updated_at")

  batches InventoryBatch[]

  @@unique([skuId, locationKey])
  @@index([storeId])
  @@index([warehouseType])
  @@map("inventories")
}

model InventoryBatch {
  id           String    @id @default(cuid())
  inventoryId  String    @map("inventory_id")
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  skuId        String    @map("sku_id")
  sku          Sku       @relation(fields: [skuId], references: [id])
  batchNumber  String    @map("batch_number")
  quantity     Int
  expiryDate   DateTime  @map("expiry_date")
  receivedAt   DateTime  @default(now()) @map("received_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([inventoryId, expiryDate]) // FIFO: order by expiryDate ASC
  @@index([skuId])
  @@map("inventory_batches")
}

model SafetyStockRule {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  skuId           String   @map("sku_id")
  sku             Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  safetyThreshold Int      @map("safety_threshold")
  reorderQty      Int      @default(0) @map("reorder_qty") // suggested qty for restock
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([storeId, skuId])
  @@map("safety_stock_rules")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  skuId       String                @map("sku_id")
  sku         Sku                   @relation(fields: [skuId], references: [id])
  storeId     String?               @map("store_id")
  store       Store?                @relation(fields: [storeId], references: [id])
  warehouseType WarehouseType       @map("warehouse_type")
  movementType InventoryMovementType @map("movement_type")
  quantity    Int
  batchNumber String?               @map("batch_number")
  referenceId String?               @map("reference_id") // order id, transfer id, etc.
  notes       String?
  createdById String?               @map("created_by_id")
  createdBy   User?                 @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([skuId, createdAt])
  @@index([storeId])
  @@map("inventory_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders & Order Items
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @map("order_number") // HVP-ORD-20250101-0001
  storeId         String      @map("store_id")
  store           Store       @relation(fields: [storeId], references: [id])
  status          OrderStatus @default(draft)
  createdById     String      @map("created_by_id")
  createdBy       User        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // Pricing (snapshot at order time)
  currency        String
  exchangeRate    Decimal     @map("exchange_rate") @db.Decimal(18, 8)
  subtotalUsd     Decimal     @map("subtotal_usd") @db.Decimal(12, 2)
  subtotalLocal   Decimal     @map("subtotal_local") @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  dutyAmount      Decimal     @default(0) @map("duty_amount") @db.Decimal(12, 2)
  shippingAmount  Decimal     @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)

  notes           String?
  paidAt          DateTime?   @map("paid_at")
  shippedAt       DateTime?   @map("shipped_at")
  completedAt     DateTime?   @map("completed_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items     OrderItem[]
  payments  Payment[]
  shipment  Shipment?

  @@index([storeId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId           String   @map("sku_id")
  sku             Sku      @relation(fields: [skuId], references: [id])
  quantity        Int
  unitPriceUsd    Decimal  @map("unit_price_usd") @db.Decimal(12, 2)
  unitPriceLocal  Decimal  @map("unit_price_local") @db.Decimal(12, 2)
  lineTotalUsd    Decimal  @map("line_total_usd") @db.Decimal(12, 2)
  lineTotalLocal  Decimal  @map("line_total_local") @db.Decimal(12, 2)
  skuSnapshot     Json?    @map("sku_snapshot") // flavour, weight at order time

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(pending)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String
  externalId      String?       @map("external_id") // Stripe/PayPal payment id
  wireReceiptUrl  String?       @map("wire_receipt_url")
  approvedById    String?       @map("approved_by_id")
  approvedBy      User?         @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?     @map("approved_at")
  failureReason   String?       @map("failure_reason")
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Logistics & International Shipping
// ─────────────────────────────────────────────────────────────────────────────

model Shipment {
  id              String   @id @default(cuid())
  orderId         String   @unique @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier         String?  // Maersk, DHL, FedEx, etc.
  trackingNumber  String?  @map("tracking_number")
  containerId     String?  @map("container_id")
  vesselFlight    String?  @map("vessel_flight")
  originPort      String?  @map("origin_port")
  destinationPort String?  @map("destination_port")
  estimatedArrival DateTime? @map("estimated_arrival")
  customsNotes    String?  @map("customs_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  milestones ShipmentMilestoneRecord[]

  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentMilestoneRecord {
  id          String            @id @default(cuid())
  shipmentId  String            @map("shipment_id")
  shipment    Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  milestone   ShipmentMilestone
  title       String
  description String?
  location    String?
  occurredAt  DateTime          @map("occurred_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([shipmentId, occurredAt])
  @@map("shipment_milestone_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance: Exchange rates & sales analytics cache
// ─────────────────────────────────────────────────────────────────────────────

model ExchangeRate {
  id           String   @id @default(cuid())
  baseCurrency String   @default("USD") @map("base_currency")
  targetCurrency String @map("target_currency")
  rate         Decimal  @db.Decimal(18, 8)
  source       String   @default("mock_api") // mock_api, openexchangerates, etc.
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@unique([baseCurrency, targetCurrency])
  @@index([fetchedAt])
  @@map("exchange_rates")
}

model StoreSaleRecord {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  skuId       String?  @map("sku_id")
  quantity    Int
  revenueUsd  Decimal  @map("revenue_usd") @db.Decimal(12, 2)
  revenueLocal Decimal @map("revenue_local") @db.Decimal(12, 2)
  currency    String
  soldAt      DateTime @map("sold_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId, soldAt])
  @@index([skuId, soldAt])
  @@map("store_sale_records")
}
